# Copy this file to .env and replace every CHANGE_ME value with a strong, unique password (min 12 chars).
# Never commit .env or real credentials.

APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
APP_OPERATOR_USERNAME=operator
APP_OPERATOR_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
APP_GUEST_USERNAME=guest
APP_GUEST_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
BOOKING_HOST_ADDRESS=127.0.0.1
BOOKING_AVAILABILITY_ROOMS_PREVENT_OVERLAP=true
BOOKING_AVAILABILITY_CARS_PREVENT_OVERLAP=true
# Production licensing is mandatory: base64 X.509 Ed25519 public key.
# This example uses the embedded product key; replace it only when signing with a different keypair.
APP_LICENSE_PUBLIC_KEY=MCowBQYDK2VwAyEAmi1yDWu05LnXrnmFwnYS62X+QAl3xPWYvtYyBvHFjig=
# Development/testing only - NEVER enable in production
#APP_LICENSE_BYPASS=false

