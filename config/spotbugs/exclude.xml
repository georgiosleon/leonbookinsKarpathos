<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Generated frontend assets and build output -->
  <Match>
    <Source name="~.*generated.*"/>
  </Match>

  <!-- Spring-managed dependency injection stores mutable collaborators by design. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <!-- Login page uses a Java text block as a formatted HTML template. -->
  <Match>
    <Class name="com.leonsoft.api.LoginPageController"/>
    <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
  </Match>
</FindBugsFilter>
